# Скопируйте этот файл как secret.properties и подставьте ключи.
# OpenAI: https://platform.openai.com/api-keys
# Apify (для MCP погоды): https://console.apify.com/account/integrations
# MCP свой сервер (День 17): полный URL до /mcp, например http://ВАШ_IP:8080/mcp

OPENAI_API_KEY=ваш ключ
APIFY_API_KEY=
MCP_CUSTOM_SERVER_URL=
# Ollama для RAG (День 22): базовый URL API, например http://10.0.2.2:11434 (эмулятор → хост) или http://127.0.0.1:11434
OLLAMA_HOST=
